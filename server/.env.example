# ==============================================================================
# GuardianX Backend Environment Configuration Template (.env.example)
# IMPORTANT: DO NOT COMMIT ACTUAL PRODUCTION SECRETS OR CREDENTIALS TO GIT
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Local or MongoDB Atlas SRV)
# Development Example: mongodb://localhost:27017/guardianx
# Staging/Production Example: mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/guardianx?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://opxmirza:<PASSWORD>@cluster0.c4lqamw.mongodb.net/guardianx?retryWrites=true&w=majority&appName=Cluster0

# JWT Token Cryptographic Secret Keys (Use strong random strings in staging/production)
JWT_SECRET=your_staging_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_staging_jwt_refresh_secret_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins Configuration (Use exact domain in production e.g. https://admin.guardianx.app or *)
CORS_ORIGIN=*
